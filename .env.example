APP_NAME=Venditores
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost


APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US


APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database


PHP_CLI_SERVER_WORKERS=4


BCRYPT_ROUNDS=12


LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


DB_CONNECTION=sqlite
# Production (Supabase Postgres): use the Session pooler connection details
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.your-project-ref
# DB_PASSWORD=
# DB_SSLMODE=require


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync


CACHE_STORE=database
CACHE_PREFIX=


MEMCACHED_HOST=127.0.0.1


REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


# Use MAIL_MAILER=log locally; switch to smtp for Purelymail
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_ENCRYPTION=ssl
# Set to 0.0.0.0 to force IPv4 when port 465 is reset on an IPv6 network
MAIL_SOURCE_IP=
MAIL_HOST=smtp.purelymail.com
MAIL_PORT=465
MAIL_USERNAME=venditores@fsd.my.id
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="venditores@fsd.my.id"
MAIL_FROM_NAME="${APP_NAME}"


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Where proposal PDFs are stored: "local" for development, "supabase" in production
PROPOSAL_DISK=local


# Supabase Storage (S3 compatible): Project Settings > Storage > S3 Connection
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_SECRET=
SUPABASE_STORAGE_REGION=ap-southeast-1
SUPABASE_STORAGE_BUCKET=proposals
SUPABASE_STORAGE_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3


# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash


VITE_APP_NAME="${APP_NAME}"
